# ─── Where enquiries are delivered ──────────────────────────────────────────
# Every destination configured below is attempted. The enquiry counts as
# delivered if at least one succeeds. With none configured the form falls back
# to opening a pre-filled email to hello@evolvecrm.co.uk, exactly as the
# original static demo did — an unconfigured deployment is never silently
# broken.
#
# All of these are read on the SERVER only and never reach the browser. Do not
# rename any of them to NEXT_PUBLIC_*, which would publish them.

# ─── Email notification ─────────────────────────────────────────────────────
# Emails each enquiry to your team. Defaults target Microsoft 365, which is the
# relay the CRM on the on-prem box already uses.
#
# The enquirer's address goes in Reply-To, never in From — a stranger's address
# in From fails SPF/DMARC for their domain and lands in spam. So From must be a
# mailbox SMTP_USER is allowed to send as, or Office 365 rejects the message
# with 5.7.60 SendAsDenied. Left unset, From is SMTP_USER, which always works.
#
# Where the enquiry lands. Comma-separate for more than one recipient.
ENQUIRY_EMAIL_TO=bf@rowanrose.co.uk
# ENQUIRY_EMAIL_FROM=noreply@rowanrose.co.uk

# Defaults: smtp.office365.com, port 587, STARTTLS (SMTP_SECURE stays false).
# Set SMTP_SECURE=true only for an implicit-TLS relay on port 465.
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false

# THIS IS A LIVE CREDENTIAL. Never commit it, never paste it into a chat or a
# ticket. Set it in the host's environment settings. Note that Microsoft is
# retiring basic-auth SMTP AUTH for Exchange Online — confirm it is still
# enabled on this mailbox.
SMTP_USER=
SMTP_PASS=

# ─── Google Sheets ──────────────────────────────────────────────────────────
# The spreadsheet ID is the long string in its URL, between /d/ and /edit.
# It is not a secret: access is governed by who the sheet is shared with.
GOOGLE_SHEETS_LEADS_ID=
GOOGLE_SHEETS_LEADS_TAB=Leads

# The service-account key, base64-encoded. Base64 because the JSON contains
# literal newlines inside private_key, which shells, CI systems and hosting
# dashboards each mangle differently.
#
#   macOS/Linux:  base64 -w0 key.json
#   Windows:      certutil -encode key.json tmp.b64 && findstr /v CERTIFICATE tmp.b64
#   Node:         node -e "console.log(require('fs').readFileSync('key.json','base64'))"
#
# THIS IS A LIVE CREDENTIAL. Never commit it, never paste it into a chat or a
# ticket. Set it in the host's environment settings.
GOOGLE_SHEETS_CREDENTIALS_B64=

# Alternative to the above for a host with a writable filesystem (e.g. the
# on-prem box, which is how the CRM's own Sheets sync is configured). Ignored
# when GOOGLE_SHEETS_CREDENTIALS_B64 is set.
# GOOGLE_SHEETS_KEY_PATH=./secrets/leads-key.json

# ─── Webhook (optional, independent of Sheets) ──────────────────────────────
# Any endpoint accepting a JSON POST: n8n, Make, Zapier, Formspree, or your own.
# Body: { name, business, email, phone, team, plan, message, source, submitted }
ENQUIRY_WEBHOOK_URL=
